{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External inputs acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "external-inputs/v1"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*[\\\\:\\x00-\\x1f\\x7f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "size"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "publisher",
        "source",
        "retrieved_at",
        "applicability"
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "accepted"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "evidence"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "redistribution": {
      "type": "boolean"
    },
    "access": {
      "enum": [
        "public",
        "restricted",
        "embargoed"
      ]
    }
  },
  "required": [
    "schema",
    "manifest_sha256",
    "package_sha256",
    "files",
    "provenance",
    "acceptance",
    "license",
    "redistribution",
    "access"
  ]
}
