{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "publication-receipt/v1"
    },
    "environment": {
      "enum": [
        "sandbox",
        "production"
      ]
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "bundle_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "staged",
        "partial",
        "published"
      ]
    },
    "records": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "planned",
              "draft",
              "staged",
              "publishing",
              "published",
              "outcome_unknown"
            ]
          },
          "deposition_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "reserved_doi": {
            "type": "string",
            "minLength": 1
          },
          "record_url": {
            "type": "string",
            "pattern": "^https://(sandbox\\.)?zenodo\\.org/records/[1-9][0-9]*$"
          },
          "version_doi": {
            "type": "string",
            "pattern": "^10\\.[0-9]{4,9}/[^\\s{}\\\\]+$"
          },
          "concept_doi": {
            "type": "string",
            "pattern": "^10\\.[0-9]{4,9}/[^\\s{}\\\\]+$"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "filename",
                "sha256",
                "size"
              ],
              "additionalProperties": false
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "publication_date": {
            "type": "string",
            "minLength": 1
          },
          "creators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "status",
          "deposition_id",
          "packages"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "published"
                }
              }
            },
            "then": {
              "required": [
                "record_url",
                "version_doi",
                "concept_doi",
                "verified_at"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "record_url"
                    ]
                  },
                  {
                    "required": [
                      "version_doi"
                    ]
                  },
                  {
                    "required": [
                      "concept_doi"
                    ]
                  },
                  {
                    "required": [
                      "verified_at"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "environment",
    "repository_id",
    "operation_id",
    "source_sha",
    "bundle_receipt_sha256",
    "status",
    "records"
  ],
  "additionalProperties": false
}
